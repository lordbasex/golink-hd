# The engine's sources.

CORE_DIR ?= .

INCFLAGS := -I$(CORE_DIR)/include -I$(CORE_DIR)/src -I$(CORE_DIR)/src/3d

ENGINE_C := \
	$(CORE_DIR)/src/art.c \
	$(CORE_DIR)/src/audio.c \
	$(CORE_DIR)/src/bones.c \
	$(CORE_DIR)/src/content.c \
	$(CORE_DIR)/src/draw.c \
	$(CORE_DIR)/src/fx.c \
	$(CORE_DIR)/src/gfx.c \
	$(CORE_DIR)/src/game.c \
	$(CORE_DIR)/src/inflate.c \
	$(CORE_DIR)/src/json.c \
	$(CORE_DIR)/src/level.c \
	$(CORE_DIR)/src/mode7.c \
	$(CORE_DIR)/src/path.c \
	$(CORE_DIR)/src/png.c \
	$(CORE_DIR)/src/save.c \
	$(CORE_DIR)/src/sha256.c \
	$(CORE_DIR)/src/rig.c \
	$(CORE_DIR)/src/stage.c \
	$(CORE_DIR)/src/par.c \
	$(CORE_DIR)/src/picture.c \
	$(CORE_DIR)/src/showcase.c \
	$(CORE_DIR)/src/sound.c \
	$(CORE_DIR)/src/sprite.c \
	$(CORE_DIR)/src/boss.c \
	$(CORE_DIR)/src/text.c \
	$(CORE_DIR)/src/zip.c

# The 3D renderer (docs/3d.md); `make NO_3D=1` builds the engine without it.
ifeq ($(NO_3D),1)
  INCFLAGS += -DHD_NO_3D
else
  ENGINE_C += $(CORE_DIR)/src/3d/r3d.c $(CORE_DIR)/src/3d/tex3d.c $(CORE_DIR)/src/3d/actor3d.c $(CORE_DIR)/src/3d/room3d.c \
	$(CORE_DIR)/src/3d/play3d.c $(CORE_DIR)/src/3d/games/remote/remote.c $(CORE_DIR)/src/3d/games/remote/remote_text.c
endif

SOURCES_C := $(ENGINE_C) $(CORE_DIR)/src/api.c
